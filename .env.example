# Скопируй в .env (cp .env.example .env) и подставь свои значения. Файл .env в Git не попадает.

# PostgreSQL (сервис db в docker-compose.yml)
POSTGRES_DB=taskmanager
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django (читаются в backend/config/settings.py, см. issue #2)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
